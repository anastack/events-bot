# Токен бота от @BotFather
BOT_TOKEN=ваш_токен_бота

# Username канала (например @mychannel) или числовой ID (например -1001234567890)
CHANNEL_ID=@mychannel

# Часовой пояс для расписания дайджеста (по умолчанию: Europe/Moscow)
TIMEZONE=Europe/Moscow

# Время отправки дайджеста (по умолчанию: 10:00)
DIGEST_HOUR=10
DIGEST_MINUTE=0

# ID Telegram-аккаунтов, которым разрешена команда /digest
# Оставьте пустым, чтобы разрешить всем
# Узнать свой ID можно у @userinfobot
ADMIN_IDS=123456789,987654321

# Путь к файлу базы данных SQLite (по умолчанию: events.db в папке бота)
# На Railway/Render/VPS укажите путь к постоянному тому, чтобы данные не терялись при деплое
# Пример: DB_PATH=/data/events.db
# DB_PATH=events.db

# ── Channel Parser (channel_parser.py) ──────────────────────────────────────
# Telegram API credentials для Telethon (получить на https://my.telegram.org)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here

# OpenRouter API key (получить на https://openrouter.ai)
OPENROUTER_API_KEY=sk-or-v1-...

# Модель AI для классификации (по умолчанию: google/gemini-2.5-flash)
OPENROUTER_MODEL=google/gemini-2.5-flash

# Каналы для мониторинга (через запятую: @username или числовой ID)
PARSER_CHANNELS=@channel1,@channel2,@channel3

# user_id, от имени которого добавляются спарсенные мероприятия (по умолчанию: 0)
PARSER_USER_ID=0

# StringSession для Telethon (для Railway/серверного деплоя)
# Сгенерировать: python generate_session.py
# Скопировать строку и вставить сюда или в переменные окружения Railway
TELETHON_SESSION=
