# Токен бота от @BotFather
BOT_TOKEN=ваш_токен_бота

# Username канала (например @mychannel) или числовой ID (например -1001234567890)
CHANNEL_ID=@mychannel

# Часовой пояс для расписания дайджеста (по умолчанию: Europe/Moscow)
TIMEZONE=Europe/Moscow

# Время отправки дайджеста (по умолчанию: 10:00)
DIGEST_HOUR=10
DIGEST_MINUTE=0

# ID Telegram-аккаунтов, которым разрешена команда /digest
# Оставьте пустым, чтобы разрешить всем
# Узнать свой ID можно у @userinfobot
ADMIN_IDS=123456789,987654321

# Путь к файлу базы данных SQLite (по умолчанию: events.db в папке бота)
# На Railway/Render/VPS укажите путь к постоянному тому, чтобы данные не терялись при деплое
# Пример: DB_PATH=/data/events.db
# DB_PATH=events.db
